# 70 "/root/.topspin-BladeEpu/local_acqu/111024_32pmmHXY_S_TFLA_MAS_dependence_purch_and_BM_TWC_EB/211/lists/pp/cpneo2.towi" 2

  1u fq=cnst1:f1 6u setrtp0|6 \n              4u setrtp0^6
  (p2 pl2 ph1):f2
  (p15 pl1 ph2):f1 (p15:sp0 ph10):f2
;	1u
;	(p1 pl11 ph3):f1
  1u pl12:f2 
	1u cpds2:f2 		;pl12 is used here with tppm, spinal, pl13 with cwlg, cwlgs
  go=2 ph31 finally do:f2
  1m do:f2
  wr #0
HaltAcqu, 1m
exit

ph0= 0
ph1= 1 3
ph2= 0 0 2 2 1 1 3 3
ph3= 1 1 3 3 2 2 0 0
ph10= 0
ph31= 0 2 2 0 1 3 3 1
